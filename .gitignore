# =====================================================
# SimuPharma .gitignore
# =====================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# --- Virtual Environments ---
.venv/
venv/
ENV/

# --- Environment & Secrets ---
.env
.env.local
.env.production
*.pem
*.key

# --- Database ---
*.db
*.sqlite3

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Logs ---
logs/
*.log

# --- Coverage & Testing ---
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.tox/

# --- Distribution ---
*.tar.gz
*.whl
