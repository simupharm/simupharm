# =====================================================
# SimuPharma Environment Variables — TEMPLATE
# =====================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Environment ---
# development | staging | production
ENVIRONMENT=development

# --- Security ---
SIMUPHARMA_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
DATABASE_URL=sqlite:///./backend/simupharma.db
# DATABASE_URL=postgresql://user:password@localhost:5432/simupharma

# --- CORS ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# --- External APIs ---
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
GEMINI_API_KEY=

# --- Rate Limiting ---
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_API=60/minute

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Email / SMTP ---
# Leave SMTP_HOST empty to print emails to console (dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@simupharma.com
SMTP_USE_TLS=true

# --- Frontend URL (for email links) ---
FRONTEND_URL=http://localhost:5500

# --- Token Expiry ---
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# --- Razorpay / Payments ---
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
# Create these Plan IDs in Razorpay Dashboard
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_SEMESTER=
RAZORPAY_PLAN_PRO_ANNUAL=
